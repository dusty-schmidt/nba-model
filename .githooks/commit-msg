#!/usr/bin/env python3
"""commit-msg — lab commit rule: subject, blank line, then 1-3 sentences on what changed and why.

The body is the granular record of the lab's history (git log is the store; nothing copies it).
A message that passes gets a `Lab-Machine: <hostname>` trailer: the machine the commit was made
on (registry names are hostnames). One already in the message is kept, so a commit made for work
done elsewhere can name that machine itself; `lab version changes` reads them back.
Enabled per clone with: git config core.hooksPath .githooks
"""
import re, socket, subprocess, sys

TRAILER = re.compile(r"^[A-Za-z][A-Za-z-]*: \S")
ABBREV = re.compile(r"\b(e\.g|i\.e|etc|vs)\.", re.I)
SCISSORS = "------------------------ >8 ------------------------"
EXEMPT = ("Merge ", "Revert ", "fixup! ", "squash! ")


def problems(msg):
    msg = msg.split("\n# " + SCISSORS)[0]  # commit.verbose puts the diff below this line
    lines = [l.rstrip() for l in msg.splitlines() if not l.startswith("#")]
    while lines and not lines[-1]:
        lines.pop()
    while lines and TRAILER.match(lines[-1]):  # trailers sit at the end
        lines.pop()
    while lines and not lines[-1]:
        lines.pop()
    if not lines or not lines[0].strip():
        return ["empty message"]
    if lines[0].startswith(EXEMPT):
        return []
    if len(lines) == 1:
        return ["add a body after a blank line: 1-3 sentences on what changed and why"]
    if lines[1]:
        return ["leave a blank line after the subject"]
    body = ABBREV.sub("", " ".join(l.strip() for l in lines[2:] if l.strip()))
    if not body:
        return ["add a body after a blank line: 1-3 sentences on what changed and why"]
    n = max(1, len(re.findall(r"[.!?](?=\s|$)", body)))
    if n > 3:
        return [f"the body has {n} sentences; keep it to 1-3 (details go in the README or plan)"]
    return []


def stamp(path):
    """Add the Lab-Machine trailer unless the message already has one (git interpret-trailers)."""
    machine = socket.gethostname().split(".")[0]
    subprocess.run(["git", "interpret-trailers", "--in-place", "--if-exists", "doNothing",
                    "--trailer", f"Lab-Machine: {machine}", path], check=False)


if __name__ == "__main__":
    with open(sys.argv[1]) as f:
        found = problems(f.read())
    for p in found:
        print(f"commit-msg: {p}", file=sys.stderr)
    if not found:
        stamp(sys.argv[1])
    sys.exit(1 if found else 0)
